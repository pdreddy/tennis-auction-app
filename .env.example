# Supabase project settings used by the browser app.
# Copy to .env.local for local development and set the same VITE_* variables in Vercel/Netlify.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only values used by migration/bootstrap scripts. Never expose this key in client code.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional bootstrap PINs for compatibility login.
ADMIN_PIN=123456
TEAM_PIN=123456
