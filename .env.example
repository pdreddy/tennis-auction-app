# Database provider: firebase (default) or vercel.
VITE_DATABASE_PROVIDER=firebase

# Use when VITE_DATABASE_PROVIDER=vercel. This points the browser at the Vercel API route.
VITE_DATABASE_API_BASE=/api/db
VITE_VERCEL_DB_POLL_MS=1000

# Server-only values for the Vercel API route when using the vercel provider.
# Add these in Vercel Project Settings > Environment Variables; do not expose them with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VERCEL_DB_KEY=tennis-auction-app:data

# Firebase provider settings. Copy this file to .env.local for local development.
# Add the same VITE_ variables to your Vercel project settings when using Firebase in production.
VITE_FIREBASE_API_KEY=AIzaSyCO2SRwIwvqXJwqQNi3NfpDRFoE8DUyXj0
VITE_FIREBASE_AUTH_DOMAIN=pdrdata-bcdc9.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://pdrdata-bcdc9-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=pdrdata-bcdc9
VITE_FIREBASE_STORAGE_BUCKET=pdrdata-bcdc9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=95091760805
VITE_FIREBASE_APP_ID=1:95091760805:web:d9232ada50b52e1903374c

# Optional Realtime Database paths. Leave blank to use the app defaults.
VITE_FIREBASE_CONFIG_PATH=config
VITE_FIREBASE_USERS_PATH=users
VITE_FIREBASE_AUCTIONS_PATH=koc3auctionsdata
