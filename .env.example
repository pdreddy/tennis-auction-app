# Database provider: firebase (default) or vercel.
# Use vercel for the API-backed Upstash Redis adapter on either Vercel or Netlify.
VITE_DATABASE_PROVIDER=firebase

# Use when VITE_DATABASE_PROVIDER=vercel. /api/db works on both Vercel and Netlify.
VITE_DATABASE_API_BASE=/api/db
VITE_VERCEL_DB_POLL_MS=1000

# Server-only values for the API-backed Upstash Redis route.
# Add these in your host environment variable settings; do not expose them with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VERCEL_DB_KEY=tennis-auction-app:data
NETLIFY_DB_KEY=tennis-auction-app:data

# Firebase provider settings. Copy this file to .env.local for local development.
# Add the same VITE_ variables to your host settings when using Firebase in production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Realtime Database paths. Leave blank to use the app defaults.
VITE_FIREBASE_CONFIG_PATH=config
VITE_FIREBASE_USERS_PATH=users
VITE_FIREBASE_AUCTIONS_PATH=auctionsdata
