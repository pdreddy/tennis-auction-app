# Database provider: netlify (default for new deploys), firebase, or vercel.
VITE_DATABASE_PROVIDER=netlify

# Use when VITE_DATABASE_PROVIDER=netlify or vercel. Netlify redirects /api/db/* to a Netlify Function.
VITE_DATABASE_API_BASE=/api/db
VITE_DATABASE_POLL_MS=1000
# Backward-compatible old name; prefer VITE_DATABASE_POLL_MS for new installs.
VITE_VERCEL_DB_POLL_MS=1000

# Server-only values for the Netlify/Vercel API route when using the netlify or vercel provider.
# Add these in your hosting provider's environment variables; do not expose them with VITE_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional aliases if you want Netlify-specific names.
NETLIFY_DB_KEY=tennis-auction-app:data
NETLIFY_BLOBS_REDIS_URL=
NETLIFY_BLOBS_REDIS_TOKEN=
# Backward-compatible Vercel key name.
VERCEL_DB_KEY=tennis-auction-app:data

# Firebase provider settings. Copy this file to .env.local for local development.
# Add the same VITE_ variables to your hosting provider when using Firebase in production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Realtime Database paths. Leave blank to use the app defaults.
VITE_FIREBASE_CONFIG_PATH=config
VITE_FIREBASE_USERS_PATH=users
VITE_FIREBASE_AUCTIONS_PATH=auctionsdata
