# Optional Realtime Database paths. Leave blank to use the app defaults.
VITE_FIREBASE_CONFIG_PATH=config
VITE_FIREBASE_USERS_PATH=users
VITE_FIREBASE_AUCTIONS_PATH=auctionsdata
